# shared
SERVICE_TOKEN=change-me
DATABASE_URL=postgresql+asyncpg://callmate:callmate@localhost:5432/callmate
LOG_LEVEL=INFO

# pipeline
TELEPHONY_MODE=media_streams            # media_streams | conversation_relay
PUBLIC_BASE_URL=https://<ngrok-id>.ngrok-free.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
STT_PROVIDER=mock                       # deepgram_flux | deepgram_nova | google | mock
DEEPGRAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
TTS_PROVIDER=mock                       # elevenlabs | google | mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BRAIN_MODE=remote                       # remote | echo
BRAIN_WS_URL=ws://localhost:8001/v1/calls
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUDIO_RETENTION_DAYS=7

# brain
LLM_PROVIDER=mock                       # anthropic | gemini | mock
ANTHROPIC_API_KEY=
REPLY_MODEL=claude-haiku-5-5
SUMMARY_MODEL=claude-sonnet-5-5
GOOGLE_API_KEY=                         # gemini fallback + embeddings
EMBEDDING_PROVIDER=local                # gemini | local
TRANSCRIPT_RETENTION_DAYS=30
