# shared
SERVICE_TOKEN=change-me
DATABASE_URL=postgresql+asyncpg://callmate:callmate@localhost:5432/callmate
LOG_LEVEL=INFO

# pipeline
TELEPHONY_MODE=media_streams            # media_streams | conversation_relay
PUBLIC_BASE_URL=https://<ngrok-id>.ngrok-free.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
STT_PROVIDER=mock                       # deepgram_flux | deepgram_nova | google | mock
DEEPGRAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
TTS_PROVIDER=mock                       # elevenlabs | google | mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BRAIN_MODE=remote                       # remote | echo
BRAIN_WS_URL=ws://localhost:8001/v1/calls
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUDIO_RETENTION_DAYS=7

# brain
REPLY_LLM_PROVIDER=mock                 # groq | mock
GROQ_API_KEY=
REPLY_MODEL=openai/gpt-oss-20b
SUMMARY_LLM_PROVIDER=mock               # nvidia | mock
NVIDIA_API_KEY=
SUMMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBEDDING_PROVIDER=local                # nvidia | local
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
TRANSCRIPT_RETENTION_DAYS=30
REDIS_URL=                              # empty = repeat-call tracking disabled (always 0)
REPEAT_CALL_WINDOW_S=600
